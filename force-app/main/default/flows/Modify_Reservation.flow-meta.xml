        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Confirmation_Message</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Active_Reservation.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Party_Size__c</field>

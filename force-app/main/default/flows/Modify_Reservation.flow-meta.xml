<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Confirmation_Message</name>
        <label>Set Confirmation Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_ConfirmationMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reservation successfully updated. Party size set to {!var_NewPartySize}.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Reservation_Identifier_Provided</name>
        <label>Reservation Identifier Provided?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Active_Reservation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nearest Active (Default)</defaultConnectorLabel>
        <rules>
            <name>Specific_ID_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_ReservationIdentifier</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Specific_Reservation</targetReference>
            </connector>
            <label>Specific ID Provided</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>for_DefaultDateTime</name>
        <dataType>DateTime</dataType>
        <expression>BLANKVALUE({!var_NewDateTime}, {!Get_Active_Reservation.Reservation_Time__c})</expression>
    </formulas>
    <formulas>
        <name>for_DefaultPartySize</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!var_NewPartySize}, {!Get_Active_Reservation.Party_Size__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>for_DefaultSpecialRequests</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!var_NewSpecialRequests}, {!Get_Active_Reservation.Special_Requests__c})</expression>
    </formulas>
    <formulas>
        <name>for_SpecificDateTime</name>
        <dataType>DateTime</dataType>
        <expression>BLANKVALUE({!var_NewDateTime}, {!Get_Specific_Reservation.Reservation_Time__c})</expression>
    </formulas>
    <formulas>
        <name>for_SpecificPartySize</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!var_NewPartySize}, {!Get_Specific_Reservation.Party_Size__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>for_SpecificSpecialRequests</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!var_NewSpecialRequests}, {!Get_Specific_Reservation.Special_Requests__c})</expression>
    </formulas>
    <interviewLabel>Modify Reservation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Modify Reservation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>

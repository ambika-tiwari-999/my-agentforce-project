    <formulas>
        <name>for_NextReservationId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Latest_Reservation.Reservation_ID__c}),
   &quot;RES-031&quot;,
   IF(VALUE(RIGHT({!Get_Latest_Reservation.Reservation_ID__c}, 3)) + 1 &lt; 100,
      &quot;RES-0&quot; &amp; TEXT(VALUE(RIGHT({!Get_Latest_Reservation.Reservation_ID__c}, 3)) + 1),
      &quot;RES-&quot; &amp; TEXT(VALUE(RIGHT({!Get_Latest_Reservation.Reservation_ID__c}, 3)) + 1)
   )
)</expression>
    </formulas>

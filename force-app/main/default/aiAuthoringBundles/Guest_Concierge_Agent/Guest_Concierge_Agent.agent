system:
    instructions: |
        You are the front door for guests. You never answer reservation or policy
        questions yourself and never invent details. Route each request to the right
        specialist, ask a short clarifying question, or escalate to a human.
    messages:
        welcome: "Hi! I can book, change, or cancel a reservation, or answer your questions. What can I help with?"
        error: "Sorry, something went wrong on my side. Let's try that again."

config:
    agent_label: "Guest Concierge Agent"
    agent_template: "SvcCopilotTmpl__AgentforceServiceAgent"
    developer_name: "Guest_Concierge_Agent"
    description: "Deliver personalized customer interactions with an autonomous AI agent. Agentforce Service Agent intelligently supports your customers with common inquiries and escalates complex issues."

access:
    default_agent_user: "guest_concierge_agent@00dg700000m98ec419929273.ext"

connection messaging:
    escalation_message: "One moment while I connect you with a member of our team."
    outbound_route_type: "OmniChannelFlow"
    outbound_route_name: "Route_Guest_Escalations"

variables:
    EndUserId: linked string
        source: @MessagingSession.EndUserId
    RoutableId: linked string
        source: @MessagingSession.Id
    ContactId: linked string
        source: @MessagingSession.ContactId
    escalation_case_id: mutable string = ""
    escalation_case_number: mutable string = ""
    unclear_turns: mutable number = 0

connected_subagent Reservations_Agent:
    label: "Reservations Agent"
    target: "agentforce://TableCraft_Bookings_Test"
    loading_text: "Checking reservations..."
    description: "Creates/books, modifies, and cancels reservations, and looks up existing reservation details."
    inputs:
        ContactId: string = @variables.ContactId

connected_subagent FAQ_Agent:
    label: "FAQ Agent"
    target: "agentforce://Joe_Test_FAQ_Agent"
    loading_text: "Looking that up..."
    description: "Answers general questions: policies, hours, amenities, pricing information, and how-to questions. Does not change reservations."

start_agent agent_router:
    label: "Agent Router"
    description: "Classify each guest message and route to Reservations, FAQ, clarification, or human escalation."
    reasoning:
        instructions: ->
            if @variables.unclear_turns >= 2:
                transition to @subagent.Human_Escalation
            | Choose exactly one tool based on the guest's latest message and the conversation so far:
              - Booking, changing, cancelling, or checking a reservation → {!@actions.reservations}
              - General questions (policies, hours, amenities, pricing, how-to) → {!@actions.faq}
              - Guest asks for a person, is upset, or raises a complaint, safety, legal,
                billing dispute, or accessibility issue → {!@actions.go_to_escalation}
              - Intent unclear, or unrelated to our business → {!@actions.go_to_clarify}
              If a message mixes a question with a reservation change, handle the reservation first.
        actions:
            reservations: @connected_subagent.Reservations_Agent
            faq: @connected_subagent.FAQ_Agent
            go_to_escalation: @utils.transition to @subagent.Human_Escalation
                description: "Guest wants a human, is frustrated, or has a sensitive issue."
            go_to_clarify: @utils.transition to @subagent.Clarify
                description: "The request is ambiguous or out of scope."

subagent Clarify:
    label: "Clarify"
    description: "Ask one short question to understand an unclear or out-of-scope request."
    reasoning:
        instructions: ->
            set @variables.unclear_turns = @variables.unclear_turns + 1
            | Briefly say what you can help with (reservations and general questions)
              and ask one short question to understand what the guest needs.

subagent Human_Escalation:
    label: "Human Escalation"
    description: "Create a case summarizing the conversation, then hand the guest to a human."
    reasoning:
        instructions: ->
            | The guest needs a human. If the reason isn't clear yet, ask one short question.
              Then call {!@actions.create_case} with a 1–3 sentence summary and the reason.
              Once the case exists, share case number {!@variables.escalation_case_number}
              and call {!@actions.handoff_to_human}.
              If the handoff isn't available (for example, after hours), tell the guest
              the team will follow up on their case.
        actions:
            create_case: @actions.create_escalation_case
                with summary = ...
                with reason = ...
                with contact_id = @variables.ContactId
                with messaging_session_id = @variables.RoutableId
                set @variables.escalation_case_id = @outputs.case_id
                set @variables.escalation_case_number = @outputs.case_number
                available when @variables.escalation_case_id == ""
            handoff_to_human: @utils.escalate
                description: "Transfer to a human rep. Only after the escalation case exists."
                available when @variables.escalation_case_id != ""
    actions:
        create_escalation_case:
            description: "Creates (or reuses) the escalation case for this conversation."
            inputs:
                summary: string
                reason: string
                contact_id: string
                messaging_session_id: string
            outputs:
                case_id: string
                case_number: string
            target: "flow://Create_Escalation_Case"
